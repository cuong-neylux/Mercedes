        lt_9001      TYPE STANDARD TABLE OF pa9001,
        ls_9001      TYPE pa9001,
        lt_0001      TYPE STANDARD TABLE OF pa0001,
        ls_0001      TYPE pa0001,
        lt_0002      TYPE STANDARD TABLE OF pa0002,
        ls_0002      TYPE pa0002,
        lv_country   TYPE scustom-country,
        lv_sum       TYPE int4.

  SELECT * FROM pa9001 INTO TABLE lt_9001 WHERE begda <= sy-datum AND endda >= sy-datum.
  SELECT * FROM pa0001 INTO TABLE lt_0001 WHERE begda <= sy-datum AND endda >= sy-datum.
  SELECT * FROM pa0002 INTO TABLE lt_0002 WHERE begda <= sy-datum AND endda >= sy-datum.
  SELECT * FROM zconcur_dba_hist INTO TABLE gt_dba_hist WHERE auswertungsjahr <= pa_evaly.

  gv_lin = 80. gv_tabix = 100.
  PERFORM progress_indicator USING '4' '00000000' gv_lin gv_tabix.

*  SORT gt_trip BY report_id segment_key itinerary_key kim work_loc_land1 datv1 uhrv1 ASCENDING.
  DELETE ADJACENT DUPLICATES FROM gt_trip COMPARING report_id segment_key itinerary_key kim datv1 uhrv1.
  LOOP AT kim.
    LOOP AT gt_dba INTO gs_dba.
* Filter trips (by country and reading period)
      LOOP AT gt_dba_fm INTO gs_dba_fm WHERE rulet EQ gs_dba-rulet
                                       AND   begda LE gv_end_reaper
                                       AND   endda GE gv_beg_reaper.
      ENDLOOP.
      CHECK sy-subrc EQ 0 AND NOT gs_dba_fm-fname IS INITIAL.

      CLEAR: lt_trip_fm[], lt_output_fm[], gt_trip_aux[].
      gt_trip_aux[] = gt_trip[].
      LOOP AT gt_trip INTO gs_trip WHERE work_loc_land1 EQ gs_dba-land1 AND kim = kim-low.
        APPEND gs_trip TO lt_trip_fm.
        LOOP AT gt_trip_aux INTO gs_trip_aux WHERE kim EQ gs_trip-kim
                                                   AND report_id EQ gs_trip-report_id
                                                   AND departure_date > gs_trip-departure_date.
*                                                 AND itinerary_key EQ gs_trip-itinerary_key
*                                                 AND departure_city EQ gs_trip-arrival_city
*                                                 AND segment_key GE ( gs_trip-segment_key + 1 )  .
*        IF gs_trip_aux-departure_country =  gs_trip-work_loc_country.
          APPEND gs_trip_aux TO lt_trip_fm.
*        ENDIF.
        ENDLOOP.
      ENDLOOP.

      SORT lt_trip_fm BY kim datv1 uhrv1 report_id ASCENDING.
      DELETE ADJACENT DUPLICATES FROM lt_trip_fm COMPARING report_id segment_key itinerary_key kim datv1 uhrv1.
* Begin of Insert: Check duplicate data - HT - 13.04.2023
      DELETE ADJACENT DUPLICATES FROM lt_trip_fm COMPARING segment_key kim datv1 uhrv1 datb1 uhrb1.
* End of Insert: Check duplicate data - HT - 13.04.2023

*      Begin Insert: Filter trips from lt_trip_fm that are already evaluated in table ZCONCUR_DBA_HIST for year/kim/country - 082026
      LOOP AT lt_trip_fm INTO ls_trip_fm.
        LOOP AT gt_dba_hist TRANSPORTING NO FIELDS
             WHERE auswertungsjahr < pa_evaly
               AND kim             = ls_trip_fm-kim
               AND report_id       = ls_trip_fm-report_id
               AND work_loc_land1  = ls_trip_fm-work_loc_land1.
          EXIT.
        ENDLOOP.
        IF sy-subrc = 0.
          DELETE lt_trip_fm.
        ENDIF.
      ENDLOOP.
*      End Insert: Filter trips from lt_trip_fm that are already evaluated in table ZCONCUR_DBA_HIST for year/kim/country - 082026

      CLEAR: lt_output_fm.
      CALL FUNCTION gs_dba_fm-fname
        EXPORTING
          year       = pa_evaly
          zland      = gs_dba-land1
          concur_dba = gs_dba
        TABLES
          trip       = lt_trip_fm
          output     = lt_output_fm
                       EXCEPTIONS
                       no_data.

      CHECK sy-subrc EQ 0.

      CLEAR gs_output.


      LOOP AT lt_output_fm INTO gs_output.
        IF gs_output-work_loc_land1 EQ 'DE'.
          CONTINUE.
        ENDIF.
* Get Full Name
        READ TABLE lt_9001 INTO ls_9001 WITH KEY kim_emp = gs_output-kim.
        CONCATENATE ls_9001-vornapass  ` `  ls_9001-nachnpass INTO gs_output-ename.
*        CALL FUNCTION 'Z_GET_NAME_FOR_KIM'
*          EXPORTING
*            iv_kim            = gs_output-kim
*            iv_validity_date  = sy-datum
*            iv_screen_display = ''
*          IMPORTING
*            ev_name           = gs_output-ename
*          EXCEPTIONS
*            name_not_found    = 1
*            OTHERS            = 2.
*
*        IF sy-subrc <> 0.
** Implement suitable error handling here
*          gs_output-ename = ''.
*        ENDIF.
* Get ePeople-Personalnummer
        gs_output-empl_id = ls_9001-empl_id.
* Get Birthday
        READ TABLE lt_0002 INTO ls_0002 WITH KEY pernr = ls_9001-pernr.
        gs_output-gbdat = ls_0002-gbdat.
* Get Kostenstelle
        READ TABLE lt_0001 INTO ls_0001 WITH KEY pernr = ls_9001-pernr.
        gs_output-kostl = ls_0001-kostl.
* Get Country Name
        lv_country = gs_output-work_loc_land1.
        CALL FUNCTION 'Z_GET_COUNTRY_NAME'
          EXPORTING
            country  = lv_country
            language = sy-langu
          IMPORTING
            name     = gs_output-landx.

        MODIFY lt_output_fm FROM gs_output TRANSPORTING ename empl_id gbdat kostl landx.
        IF gs_output-uhrv1_b NE '000000'.
          READ TABLE lt_output_fm WITH KEY datb1_v = gs_output-datv1_b
                                           kim = gs_output-kim
                                           TRANSPORTING NO FIELDS.
          IF sy-subrc IS INITIAL.
            SUBTRACT 1 FROM gs_output-ndays.
          ENDIF.
        ENDIF.
        IF gs_output-uhrb1_v NE '000000'.
          READ TABLE lt_output_fm WITH KEY datv1_b = gs_output-datb1_v
                                           kim = gs_output-kim
                                           TRANSPORTING NO FIELDS.
          IF sy-subrc IS INITIAL.
            SUBTRACT 1 FROM gs_output-ndays.
          ENDIF.
        ENDIF.
        MODIFY lt_output_fm FROM gs_output.

      ENDLOOP.

      DELETE lt_output_fm WHERE ndays LE 0.

* Select employees by country
* BEGIN OF DELETE - 092026
*      CLEAR gs_output.
*      LOOP AT lt_output_fm INTO gs_output WHERE work_loc_land1 NE 'DE'
*                                             AND work_loc_land1 EQ gs_dba-land1.
*        APPEND gs_output TO gt_output.
**      AT END OF kim.
*        AT END OF work_loc_land1.
*          SUM.
*          IF gs_output-ndays LE gs_dba-ntage. " AND pa_test EQ space.
*            DELETE gt_output WHERE kim EQ gs_output-kim
*                             AND   work_loc_land1 EQ gs_dba-land1.
**        CONTINUE.
*          ENDIF.
*        ENDAT.
*      ENDLOOP.
* END OF DELETE - 092026

* BEGIN of INSERT - 092026
      CLEAR: gs_output, lv_sum.
      LOOP AT lt_output_fm INTO gs_output WHERE work_loc_land1 NE 'DE'
                                             AND work_loc_land1 EQ gs_dba-land1.
        APPEND gs_output TO gt_output.
        lv_sum = lv_sum + gs_output-ndays.
      ENDLOOP.
      IF lv_sum LE gs_dba-ntage. " AND pa_test EQ space.
        DELETE gt_output WHERE kim EQ gs_output-kim
                         AND   work_loc_land1 EQ gs_dba-land1.
      ENDIF.
* END of INSERT - 092026

    ENDLOOP.
  ENDLOOP.
* Begin of Insert: Check duplicate data - HT - 13.04.2023
  DELETE ADJACENT DUPLICATES FROM gt_output COMPARING kim datv1_v uhrv1_v datb1_v uhrb1_v datv1_b uhrv1_b datb1_b uhrb1_b.
* End of Insert: Check duplicate data - HT - 13.04.2023
ENDFORM.                  " PROCESS_TRIP_DATA
