*& -->  p1        text
*& <--  p2        text
*&---------------------------------------------------------------------*
FORM get_trip_data .
  gv_lin = 40. gv_tabix = 100.
  PERFORM progress_indicator USING '2' '00000000' gv_lin gv_tabix.

  DATA ls_land1     TYPE intca.
  DATA ls_kim TYPE pa9001-kim_emp.
  DATA lt_kim TYPE TABLE OF pa9001-kim_emp.
  DATA ls_bukrs TYPE bukrs.
  DATA lt_bukrs TYPE TABLE OF bukrs.
  DATA ls_trip TYPE zconcur_dba_trip.

* If there's any KIMs/BUKRS selected in Selection Screen
  CLEAR: gs_seltab, gt_trip_tmp .
  LOOP AT gt_seltab INTO gs_seltab WHERE ( selname EQ 'BUKRS' OR selname EQ 'KIM' ) AND low IS NOT INITIAL.
    IF gs_seltab-selname EQ 'BUKRS' AND gs_seltab-low IS NOT INITIAL .
      SELECT * FROM zconcur_dba_trip INTO CORRESPONDING FIELDS OF TABLE gt_trip_tmp1 WHERE bukrs = gs_seltab-low.
      APPEND LINES OF gt_trip_tmp1 TO gt_trip_tmp.
*      APPEND gt_trip_tmp.
    ENDIF.
    IF gs_seltab-selname EQ 'KIM' AND gs_seltab-low IS NOT INITIAL .
      SELECT * FROM zconcur_dba_trip INTO CORRESPONDING FIELDS OF TABLE gt_trip_tmp1 WHERE kim = gs_seltab-low. "#EC CI_NOFIELD
      APPEND LINES OF gt_trip_tmp1 TO gt_trip_tmp.
*      APPEND gt_trip_tmp.
    ENDIF.
  ENDLOOP.

  IF sy-subrc EQ 0.
    IF gt_trip_tmp[] IS INITIAL.
* No KIM/BUKRS specified in selection screen. Take all records
*      SELECT * FROM zconcur_dba_trip INTO CORRESPONDING FIELDS OF TABLE gt_trip_tmp.
      IF sy-subrc NE 0.
        MESSAGE s007.  " No trip data found for specified selection criteria
        STOP.
      ENDIF.
    ENDIF.
  ELSE.
* No KIM/BUKRS specified in selection screen. Take all records
    SELECT * FROM zconcur_dba_trip INTO CORRESPONDING FIELDS OF TABLE gt_trip_tmp "#EC CI_NOWHERE.
      ORDER BY report_id segment_key kim.              "#EC CI_NOWHERE.
  ENDIF.

  SORT gt_trip_tmp BY report_id segment_key kim.
  DELETE ADJACENT DUPLICATES FROM gt_trip_tmp COMPARING report_id segment_key kim.
  CLEAR ls_land1.
* only allow BUKRS with LAND1 = 'DE' in Tabelle T001
*  LOOP AT gt_trip_tmp INTO ls_trip.
*    CALL FUNCTION 'BBP_GET_COMPANY_COUNTRY'
*      EXPORTING
*        iv_company = ls_trip-bukrs
*      IMPORTING
*        ev_country = ls_land1.
*    IF ls_land1 <> 'DE'.
*      DELETE gt_trip_tmp WHERE bukrs EQ ls_trip-bukrs.
*      CONTINUE.
*    ENDIF.
*  ENDLOOP.

* Eliminate duplicate versions of a trip/period
*  SORT gt_trip_tmp BY report_id segment_key itinerary_key kim work_loc_land1.
  SORT gt_trip BY kim datv1 uhrv1 report_id ASCENDING.

  IF gt_trip_tmp[] IS INITIAL.
    MESSAGE s267.
*   Display not possible because of missing authorizations
    EXIT.
  ENDIF.

** Filter destinations
  LOOP AT gt_trip_tmp .
    IF NOT ( ( gt_trip_tmp-datv1 IN rg_ldbfrom
        AND gt_trip_tmp-datb1 IN rg_ldbto )
        OR   ( gt_trip_tmp-datb1 IN rg_ldbbetween
        OR        gt_trip_tmp-datb1 IN rg_ldbbetween ) ).
      CONTINUE.
    ENDIF.

    MOVE-CORRESPONDING gt_trip_tmp TO gs_trip.
    APPEND gs_trip TO gt_trip.
  ENDLOOP.

  IF sy-subrc <> 0.
    MESSAGE s007.
    EXIT.     " No trip data found for specified selection criteria
  ENDIF.

* Eliminate duplicate versions of a trip/period
*  SORT gt_trip BY report_id segment_key itinerary_key kim work_loc_land1.
  SORT gt_trip BY kim datv1 uhrv1 report_id ASCENDING.
  DELETE ADJACENT DUPLICATES FROM gt_trip COMPARING report_id segment_key itinerary_key kim departure_date.

ENDFORM.                    " GET_TRIP_DATA
*&---------------------------------------------------------------------*
*& Form progress_indicator
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------*
*&      --> P_
*&      --> P_
*&      --> gv_lin
*&      --> gv_tabix
*&---------------------------------------------------------------------*
FORM progress_indicator  USING p_type
                               p_pernr
                               p_lin
                               p_tabix.
  DATA: lv_text TYPE string,
        lv_perc TYPE p.

  CASE p_type.

    WHEN '1'.

      lv_perc = p_lin.
      CONCATENATE 'Selektion der Mitarbeiter'(006) p_pernr INTO lv_text SEPARATED BY space.
      CALL FUNCTION 'SAPGUI_PROGRESS_INDICATOR'
        EXPORTING
          percentage = lv_perc
          text       = lv_text.

    WHEN '2'.

      lv_perc = p_lin.
      lv_text = 'Lesen der Hauptziele...'(007).
      CALL FUNCTION 'SAPGUI_PROGRESS_INDICATOR'
        EXPORTING
          percentage = lv_perc
          text       = lv_text.

    WHEN '3'.

      lv_perc = p_lin.
      lv_text = 'Lesen der Customizingdaten zu den Ländern...'(009).
      CALL FUNCTION 'SAPGUI_PROGRESS_INDICATOR'
        EXPORTING
          percentage = lv_perc
          text       = lv_text.

    WHEN '4'.

      lv_perc = p_lin.
      lv_text = 'Verarbeitung der Reisen...'(010).
      CALL FUNCTION 'SAPGUI_PROGRESS_INDICATOR'
        EXPORTING
          percentage = lv_perc
          text       = lv_text.

    WHEN '5'.

      lv_perc = p_lin.
      lv_text = 'Anzeige der Reisen...'(011).
      CALL FUNCTION 'SAPGUI_PROGRESS_INDICATOR'
        EXPORTING
          percentage = lv_perc
          text       = lv_text.

  ENDCASE.

ENDFORM.                        " PROGRESS_INDICATOR
*&---------------------------------------------------------------------*
*& Form get_country_data
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------*
*& -->  p1        text
*& <--  p2        text
*&---------------------------------------------------------------------*
FORM get_country_data .
  CONSTANTS: ct_land1 TYPE land1 VALUE 'ZZ'.

  DATA: ls_dba       TYPE zconcur_dba,
        ls_nondba    TYPE zconcur_dba,
        ls_countries LIKE gt_countries.

  DATA: lv_dbain     TYPE zconcur_dba-dbain,
        lv_dbalines  TYPE i,
        lv_countries TYPE i.

  gv_lin = 60. gv_tabix = 100.
  PERFORM progress_indicator USING '3' '00000000' gv_lin gv_tabix.

* Collect elegible countries
  LOOP AT gt_trip INTO gs_trip.
    APPEND gs_trip-work_loc_land1 TO gt_countries.
  ENDLOOP.

  SORT gt_countries BY land1.
  DELETE ADJACENT DUPLICATES FROM gt_countries.
  CHECK NOT gt_countries[] IS INITIAL.

  CASE 'X'.
    WHEN rb_dba_y.
      lv_dbain = 'X'.
    WHEN rb_dba_n.
      lv_dbain = ' '.
  ENDCASE.

* Read country customizing data
  SELECT * FROM zconcur_dba INTO TABLE gt_dba
                          FOR ALL ENTRIES IN gt_countries
                          WHERE land1 EQ gt_countries-land1
                          AND   dbain EQ lv_dbain
                          AND   begda LE gv_end_evaper
                          AND   endda GE gv_beg_evaper.

* Change to get default customizing if country not in ZCONCUR_DBA
  DESCRIBE TABLE gt_countries LINES lv_countries.
  DESCRIBE TABLE gt_dba       LINES lv_dbalines.

  IF lv_countries NE lv_dbalines.

    SELECT SINGLE * FROM zconcur_dba INTO ls_nondba
            WHERE land1 EQ ct_land1
              AND dbain EQ lv_dbain.

    IF sy-subrc EQ 0.

      LOOP AT gt_countries INTO ls_countries.

        IF lv_dbain IS INITIAL.
          SELECT SINGLE * FROM zconcur_dba INTO ls_dba
                  WHERE land1 EQ ls_countries-land1
                    AND dbain EQ 'X'
                    AND begda LE gv_end_evaper
                    AND endda GE gv_beg_evaper.
          IF sy-subrc NE 0.

            READ TABLE gt_dba WITH KEY land1 = ls_countries-land1 TRANSPORTING NO FIELDS.

            IF sy-subrc NE 0.
              IF ls_countries-land1 NE 'DE'.
                MOVE ls_countries-land1 TO ls_nondba-land1.
                APPEND ls_nondba TO gt_dba.
              ENDIF.
            ENDIF.
          ENDIF.
        ENDIF.
      ENDLOOP.
    ENDIF.
  ENDIF.

* Read rules customizing data
  SELECT * FROM zconcur_dba_fm INTO TABLE gt_dba_fm
                             WHERE begda LE gv_end_evaper
                             AND   endda GE gv_beg_evaper.

ENDFORM.              " GET_COUNTRY_DATA
