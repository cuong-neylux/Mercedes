FORM get_name  USING    kim_emp TYPE zkim
                        date  LIKE sy-datum.
  CALL FUNCTION 'Z_GET_NAME_FOR_KIM'
    EXPORTING
      iv_kim         = kim_emp
      validity_date  = date
      screen_display = 'X'
*     START_ROW      = 5
*     START_COLUMN   = 10
    IMPORTING
      name           = gs_output-ename
    EXCEPTIONS
      name_not_found = 1
      OTHERS         = 2.
  IF sy-subrc <> 0.
* Implement suitable error handling here
  ENDIF.
ENDFORM.      "get_name
