FORM authority_check .
  AUTHORITY-CHECK OBJECT 'S_TCODE'
  ID 'TCD' FIELD 'Z_CONCUR_DBA'.
  IF sy-subrc <> 0.
    MESSAGE 'Keine Brechtigung zum Ausführen des Programms!' TYPE 'E'.
  ENDIF.
ENDFORM.      "authority_check
*&---------------------------------------------------------------------*
*& Form update_database
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------*
*&---------------------------------------------------------------------*
FORM update_database .
* populate date to table ZCONCUR_DBA_HIST
  DATA: lt_dba_hist TYPE TABLE OF zconcur_dba_hist.
  DATA: ls_dba_hist TYPE zconcur_dba_hist.

  CLEAR lt_dba_hist.
  MOVE-CORRESPONDING EXACT gt_output TO lt_dba_hist.
  LOOP AT lt_dba_hist INTO ls_dba_hist.
    READ TABLE gt_dba_hist WITH KEY auswertungsjahr = pa_evaly kim = ls_dba_hist-kim report_id = ls_dba_hist-report_id work_loc_land1 = ls_dba_hist-work_loc_land1 TRANSPORTING NO FIELDS.
    IF sy-subrc <> 0.
      ls_dba_hist-auswertungsjahr = pa_evaly.
      MODIFY zconcur_dba_hist FROM ls_dba_hist.
      IF sy-subrc <> 0.
        MESSAGE 'Die Auswertung wurde nicht gespeichert!' TYPE 'E'.
      ENDIF.
    ENDIF.

  ENDLOOP.
ENDFORM.
