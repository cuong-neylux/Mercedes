*& Form call_list_viewer
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------*
*       Start list viewer
*&---------------------------------------------------------------------*
FORM call_list_viewer .
  IF NOT gv_count_reject IS INITIAL.
*   Display is incomplete because of missing authorizations
    MESSAGE s268 WITH gv_count_reject.
  ENDIF.

  DATA: lf_save,
        grid_title TYPE lvc_title.

  AUTHORITY-CHECK OBJECT 'S_ALV_LAYO' ID 'ACTVT' FIELD '23'.

  IF sy-subrc IS INITIAL.
*   user is authorized to maintain system wide variants
    lf_save = 'A'.
  ELSE.
*   user can only save variants for him/herself
    lf_save = 'U'.
  ENDIF.

  CASE 'X'.
    WHEN rb_dba_y.
      grid_title = 'DBA Auswertung'(001).
    WHEN rb_dba_n.
      grid_title = 'Non-DBA Auswertung'(002).
  ENDCASE.

  IF rb_alv IS INITIAL.
    CALL FUNCTION 'REUSE_ALV_GRID_DISPLAY'
      EXPORTING
        i_callback_program      = pgm
        i_grid_title            = grid_title
        is_layout               = layout
        it_fieldcat             = fieldcat
        it_sort                 = sortcat
        it_events               = eventcat
        i_save                  = lf_save
        is_variant              = disvariant
        i_callback_user_command = 'USER_COMMAND'
      TABLES
        t_outtab                = gt_output
      EXCEPTIONS
        program_error           = 1
        OTHERS                  = 2.
  ELSE.
    PERFORM events_definition USING eventcat.
    CALL FUNCTION 'REUSE_ALV_LIST_DISPLAY'
      EXPORTING
        i_callback_program      = pgm
        is_layout               = layout
        it_fieldcat             = fieldcat
        it_sort                 = sortcat
        it_events               = eventcat
        i_save                  = lf_save
        is_variant              = disvariant
        i_callback_user_command = 'USER_COMMAND'
      TABLES
        t_outtab                = gt_output
      EXCEPTIONS
        program_error           = 1
        OTHERS                  = 2.
  ENDIF.
ENDFORM.                  " CALL_LIST_VIEWER
